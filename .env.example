# Wasit Virtual Pencak Silat — environment configuration
# Copy to `.env.local` and adjust if needed. All values are optional.

# Path to the SQLite database file.
# Defaults to ./data/wasit.db (created automatically on first run).
# Use an absolute path on a persistent volume when deploying in Docker.
# DATABASE_PATH=/var/lib/wasit/wasit.db

# Port for `npm run start` / `npm run dev` (Next.js defaults to 3000).
# PORT=3000
